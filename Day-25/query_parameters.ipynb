      "source": [
        "import requests\n",
        "\n",
        "# Simulating a search query\n",
        "params = {\"q\": \"python-programming\", \"limit\": 5}\n",
        "url = \"https://httpbin.org/get\"\n",
        "\n",
        "response = requests.get(url, params=params)\n",
        "print(f\"Final URL: {response.url}\")\n",
        "print(f\"Server Response: {response.json()['args']}\")"
      ]
    }
  ]
