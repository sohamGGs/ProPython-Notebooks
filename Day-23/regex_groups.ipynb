      "source": [
        "import re\n",
        "\n",
        "email = \"soham.patil.cse@ghrcemp.raisoni.in\"\n",
        "pattern = r\"([\\w.]+)@([\\w.]+)\" # Group 1: Username, Group 2: Domain\n",
        "\n",
        "match = re.search(pattern, email)\n",
        "if match:\n",
        "    print(f\"User: {match.group(1)}\")\n",
        "    print(f\"Domain: {match.group(2)}\")"
      ]
    }
  ]
