      "source": [
        "import re\n",
        "\n",
        "text = \"My phone number is 987-654-3210 and my office is 123-456-7890.\"\n",
        "# Pattern: 3 digits, dash, 3 digits, dash, 4 digits\n",
        "pattern = r\"\\d{3}-\\d{3}-\\d{4}\"\n",
        "\n",
        "matches = re.findall(pattern, text)\n",
        "print(f\"Phone numbers found: {matches}\")"
      ]
    }
  ]
