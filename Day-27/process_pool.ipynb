      "source": [
        "from multiprocessing import Pool\n",
        "\n",
        "def square(n):\n",
        "    return n * n\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    numbers = [1, 2, 3, 4, 5]\n",
        "    with Pool(processes=4) as pool:\n",
        "        results = pool.map(square, numbers)\n",
        "    print(f\"Squared: {results}\")"
      ]
    }
  ]
}