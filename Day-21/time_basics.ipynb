      "source": [
        "from datetime import datetime, timedelta\n",
        "\n",
        "now = datetime.now()\n",
        "print(f\"Current: {now}\")\n",
        "print(f\"Formatted: {now.strftime('%d-%m-%Y %H:%M:%S')}\")\n",
        "\n",
        "# Date Arithmetic\n",
        "tomorrow = now + timedelta(days=1)\n",
        "print(f\"Tomorrow: {tomorrow}\")"
      ]
    }
  ]
