      "source": [
        "def infinite_even_numbers():\n",
        "    num = 0\n",
        "    while True:\n",
        "        yield num\n",
        "        num += 2\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    evens = infinite_even_numbers()\n",
        "    for _ in range(5):\n",
        "        print(next(evens))\n",
        "\n",
        "    # Dont worry, it wont crash ;)"
      ]
    }
  ]
