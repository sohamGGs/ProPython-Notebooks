      "source": [
        "def simple_generator():\n",
        "    print(\"Starting...\")\n",
        "    yield 1\n",
        "    print(\"Resuming...\")\n",
        "    yield 2\n",
        "    print(\"Ending...\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    gen = simple_generator()\n",
        "    print(next(gen)) # Runs until first yield\n",
        "    print(next(gen)) # Resumes until second yield"
      ]
    }
  ]
}