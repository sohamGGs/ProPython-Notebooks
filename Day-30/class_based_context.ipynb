      "source": [
        "class MyContext:\n",
        "    def __enter__(self):\n",
        "        print(\"Entering the context...\")\n",
        "        return self\n",
        "\n",
        "    def __exit__(self, exc_type, exc_val, exc_tb):\n",
        "        print(\"Exiting the context...\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    with MyContext():\n",
        "        print(\"Inside the block!\")"
      ]
    }
  ]
