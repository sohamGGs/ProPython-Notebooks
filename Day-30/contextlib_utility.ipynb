      "source": [
        "from contextlib import contextmanager\n",
        "\n",
        "@contextmanager\n",
        "def temporary_file_setup():\n",
        "    print(\"Setup: Creating temp file...\")\n",
        "    yield \"temp_data.txt\"\n",
        "    print(\"Teardown: Deleting temp file...\")\n",
        "\n",
        "with temporary_file_setup() as f:\n",
        "    print(f\"Working with {f}\")"
      ]
    }
  ]
}